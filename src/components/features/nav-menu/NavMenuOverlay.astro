---
import NavMenuIcon from "@src/components/icons/NavMenuIcon.astro";
import NavMenuToggle from "@src/components/features/nav-menu/NavMenuToggle.astro";
---

<div class="fixed left-0 right-0 top-0 bottom-0 flex justify-end items-center">
	<header
		class="flex flex-row justify-end h-14 p-4 mt-px mx-px absolute top-3 left-3 right-3">
		<NavMenuToggle
			transition:persist="nav-menu__toggle--overlay"
			class="h-full aspect-square pointer-events-none nav-open:pointer-events-auto">
			<NavMenuIcon class="fill-none stroke-base-dark-text-default" />
		</NavMenuToggle>
	</header>

	<nav>
		<ul
			class="font-boldonse tracking-widest uppercase text-3xl m-4 flex flex-col gap-8 z-10">
			<li><a href="/">Home</a></li>
			<li><a href="/blog">Blog</a></li>
			<li><a href="/demos">Demos</a></li>
			<li><a href="/resources">Resources</a></li>
		</ul>
	</nav>
</div>

<style>
	body[data-nav-open] nav {
		pointer-events: all;
		& ul {
			transition-delay: 250ms;
			clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
		}
	}

	nav ul {
		transition: clip-path 250ms ease-in-out;
		clip-path: polygon(100% 0%, 100% 0%, 100% 100%, 100% 100%);
	}

	nav ul li {
		text-align: right;
	}
</style>
