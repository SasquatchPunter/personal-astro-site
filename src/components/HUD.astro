---
import Block from "@src/components/HUDBlock.astro";
import Logo from "@src/components/icons/Logo.astro";
import { NavMenuToggle } from "@src/components/features/nav-menu";
import NavMenuIcon from "@src/components/icons/NavMenuIcon.astro";
---

<div class="fixed w-full h-screen pointer-events-none">
	<div class="hud-x-line top-3"></div>
	<div class="hud-x-line bottom-3"></div>
	<div class="hud-y-line left-3"></div>
	<div class="hud-y-line right-3"></div>

	<div class="hud-point top-3 left-3"></div>
	<div class="hud-point top-3 right-3"></div>
	<div class="hud-point bottom-3 left-3"></div>
	<div class="hud-point bottom-3 right-3"></div>

	<Block class="fixed mt-3">
		<header
			class="flex flex-row justify-between h-14 p-4 hover:bg-black/30 duration-200 pointer-events-auto">
			<a href="/">
				<Logo
					class="size-full fill-none stroke-2 stroke-base-dark-text-default"
				/>
			</a>

			<NavMenuToggle
				transition:persist="nav-menu__toggle"
				class="h-full aspect-square">
				<NavMenuIcon class="fill-none stroke-base-dark-text-default" />
			</NavMenuToggle>
		</header>
	</Block>
</div>
