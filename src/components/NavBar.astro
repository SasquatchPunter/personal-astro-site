---
import NavMenuToggle from "@src/components/features/nav-menu/NavMenuToggle.astro";
import NavMenuIcon from "@src/components/icons/NavMenuIcon.astro";
import Logo from "@src/components/icons/Logo.astro";

type Props = {
	class?: string;
};

const { class: className } = Astro.props;
---

<header class:list={["flex flex-row justify-between", className]}>
	<a href="/" class="pointer-events-auto">
		<Logo
			class="size-full fill-none stroke-2 stroke-base-dark-text-default"
		/>
	</a>

	<NavMenuToggle
		id="nav-menu__toggle"
		transition:persist="nav-menu__toggle"
		class="h-full aspect-square pointer-events-auto">
		<NavMenuIcon class="fill-none stroke-base-dark-text-default" />
	</NavMenuToggle>
</header>
